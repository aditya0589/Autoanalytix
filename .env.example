# Application Environment
APP_ENV=development
PROJECT_NAME=Autoanalytix

# Security & Secrets
APP_SECRET_KEY=autoanalytix-super-secret-jwt-key-2026-production-grade
CREDENTIAL_ENCRYPTION_KEY=YXV0b2FuYWx5dGl4LTMyYnl0ZXMtc2VjcmV0a2V5ISE=

# Database Configuration (SQLite default for zero-friction local development, or PostgreSQL)
DATABASE_URL=sqlite:///./autoanalytix.db
# DATABASE_URL=postgresql://autoanalytix:autoanalytix_secret_password@localhost:5432/autoanalytix

# Server & Client URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Object Storage & Limits
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=52428800

# Analytical Engine Limits
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_QUERY_TIMEOUT_SECONDS=30
DUCKDB_MAX_RESULT_ROWS=1000

# NOTE: End-user LLM provider API keys (Gemini, OpenAI, Anthropic) are NOT configured here.
# Every user configures their own encrypted API key through the Bring-Your-Own-Key (BYOK) interface at /settings/ai-providers.
